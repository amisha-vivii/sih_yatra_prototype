# ---------------------------------------------------------------------------
# YatraShield — environment template. Copy to .env and fill in real values.
# Never commit a populated .env.
# ---------------------------------------------------------------------------

# --- frontend (Vite) -------------------------------------------------------
# Base URL of the API. Leave empty to use the bundled in-app service layer.
VITE_API_BASE_URL=

# Map tiles. Supports any raster tile provider. {key} is substituted with
# VITE_MAP_API_KEY. If no key is set, OpenStreetMap tiles are used.
#   Mapbox:  https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles/{z}/{x}/{y}?access_token={key}
#   Google:  https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}&key={key}
VITE_MAP_TILE_URL=
VITE_MAP_API_KEY=
VITE_MAP_ATTRIBUTION=

# Token signing secret used by the bundled service layer.
VITE_SECRET_KEY=change-me-in-production

# --- backend (FastAPI) -----------------------------------------------------
DATABASE_URL=postgresql+psycopg://yatrashield:yatrashield@localhost:5432/yatrashield
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173

# Sentence embedding model used by the Python pipeline.
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Isolation Forest hyper-parameters.
IFOREST_ESTIMATORS=120
IFOREST_SAMPLE_SIZE=128
IFOREST_RANDOM_STATE=42

# Server-side map key (only if tiles are proxied through the API).
MAP_API_KEY=
